# Local development. Copy to .env.local (git-ignored) and fill in.
# Neon: use your "dev" branch (Branches -> Create branch) so local work never touches prod data.
# Connect -> untick "Connection pooling" (direct host). No quotes.
DATABASE_URL=postgresql://USER:PASSWORD@ep-dev-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
PORT=8080

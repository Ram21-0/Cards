# Production values. Copy to .env.prod (git-ignored) only if you run prod from your machine
# (e.g. to run migrations). On the real host, set these as environment variables instead.
# Neon: use the "main" branch. The pooled host ("-pooler") is fine for the running app,
# but migrations need the direct host.
DATABASE_URL=postgresql://USER:PASSWORD@ep-prod-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
PORT=8080

# Google sign-in: the OAuth Web client id from Google Cloud (Credentials -> OAuth client ID). Empty = sign-in answers 503 "not configured".
GOOGLE_CLIENT_ID=
